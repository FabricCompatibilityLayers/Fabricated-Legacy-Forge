{
  "schemaVersion": 1,
  "id": "fabricated-fml",
  "version": "${version}",
  "name": "Fabricated FML",
  "description": "",
  "authors": [
    "CatCore"
  ],
  "contributors": [],
  "contact": {
    "homepage": "",
    "sources": "",
    "issues": ""
  },
  "license": ["OSL-3.0", "LGPL-2.1-only"],
